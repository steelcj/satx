#!/usr/bin/env python3
"""sat -- the dispatcher. Command names are the same in every language;
per satx-shape-and-purpose-v0-0-8.md and this session's own ruling on
messages/, only the prompts and feedback a command prints translate,
driven by the instance's interface_language.

Today this dispatches `sat read`, and `sat init` scoped to exactly
HANDOVER's own test: a bare new instance, nothing beneath it yet.
Collection, archive, directory and content creation, and any
preseed-driven bulk creation, are deliberately deferred.
"""
import argparse
import sys
from pathlib import Path

INSTANCE_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(INSTANCE_ROOT / "lib"))

from satlib.archive import read_archive  # noqa: E402
from satlib.create import init_instance  # noqa: E402
from satlib.i18n import translator_for  # noqa: E402
from satlib.nodes import config_path  # noqa: E402
from satlib.yamlio import read_yaml  # noqa: E402


def _interface_language() -> str:
    for state in ("resolved", "overrides", "defaults"):
        doc = read_yaml(config_path(INSTANCE_ROOT, True, "sat", "sat", state))
        if doc and doc.get("interface_language", {}).get("value"):
            return doc["interface_language"]["value"]
    return "en-ca"


def _path_in_scope(where: str, prefix: str) -> bool:
    if prefix is None:
        return True
    return where == prefix or where.startswith(prefix + "/")


def _problem_in_scope(where: str, prefix: str) -> bool:
    """A root-level problem, most often a missing field_kinds, applies
    to everything under the root regardless of what was asked about,
    so `.` always stays in scope for problems even when scoped to one
    file or directory."""
    return where == "." or _path_in_scope(where, prefix)


def cmd_read(args, _):
    target = Path(args.path).resolve()
    try:
        relative = target.relative_to(INSTANCE_ROOT)
    except ValueError:
        print(
            _("error: {target} is not inside the instance at {root}").format(
                target=target, root=INSTANCE_ROOT
            ),
            file=sys.stderr,
        )
        return 2
    prefix = None if str(relative) == "." else str(relative).replace("\\", "/")

    # Resolution always walks the whole instance: a node's resolved
    # values depend on its ancestors, so there is no such thing as
    # resolving a single file in isolation. Only the report is scoped.
    result = read_archive(INSTANCE_ROOT)

    problems = [p for p in result["problems"] if _problem_in_scope(p["where"], prefix)]
    for problem in problems:
        label = _("ERROR") if problem["level"] == "error" else _("warn")
        print(f"{label:>5}  {problem['where']}: {problem['message']}", file=sys.stderr)

    nodes = [n for n in result["nodes"] if _path_in_scope(n["where"], prefix)]
    in_scope_where = {n["where"] for n in nodes}
    works = {}
    for work_id, work in result["works"].items():
        expressions = [e for e in work["expressions"] if e["where"] in in_scope_where]
        if expressions:
            works[work_id] = {"work": work_id, "expressions": expressions}

    print()
    print(_("nodes")+f"   {len(nodes)}")
    print(_("works")+f"   {len(works)}")
    for work in works.values():
        print()
        print(f"  {work['work']}")
        for expr in work["expressions"]:
            lang = str(expr["language"]) if expr["language"] else "?"
            print(f"    {lang:<8} {expr['where']}")

    has_errors = any(p["level"] == "error" for p in problems)
    return 1 if has_errors else 0


def cmd_init(args, _):
    target = Path(args.path).resolve()
    print(_("Creating a new SAT instance at {path}").format(path=target))
    try:
        init_instance(target, _)
    except FileExistsError as exc:
        print(_("error: {message}").format(message=exc), file=sys.stderr)
        return 2
    print(_("Run `sat read {path}` to check it.").format(path=args.path))
    return 0


def main(argv=None):
    global _
    _ = translator_for(INSTANCE_ROOT, _interface_language(), "bin")

    parser = argparse.ArgumentParser(prog="sat")
    sub = parser.add_subparsers(dest="command", required=True)

    read_parser = sub.add_parser("read", help=_("Resolve a SAT tree and report what it finds"))
    read_parser.add_argument("path", nargs="?", default=".")
    read_parser.set_defaults(func=cmd_read)

    init_parser = sub.add_parser("init", help=_("Create a new, bare SAT instance"))
    init_parser.add_argument("path")
    init_parser.set_defaults(func=cmd_init)

    args = parser.parse_args(argv)
    return args.func(args, _)


if __name__ == "__main__":
    raise SystemExit(main())
